FROM node:22-bookworm

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash ca-certificates curl git jq procps python3 python3-pip ripgrep tini \
    && rm -rf /var/lib/apt/lists/*
RUN pip3 install --break-system-packages --no-cache-dir \
    beautifulsoup4==4.14.3 httpx==0.28.1 pypdf==6.7.0 pyyaml==6.0.3

RUN usermod --login kerosene --home /home/kerosene --move-home node \
    && groupmod --new-name kerosene node
USER kerosene
WORKDIR /home/kerosene
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sleep", "infinity"]
